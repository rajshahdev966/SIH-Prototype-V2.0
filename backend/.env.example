# ==========================================
# SIH Civil Services Portal - Environment Configuration
# Copy this file to .env and configure your production values
# ==========================================

# Google Gemini API Key (Required for AI Agents)
GEMINI_API_KEY=your_gemini_api_key_here

# Initial Root Administrator Setup (Used only when the database is first initialized)
# Change these values before starting the application for the first time!
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=ChangeThisToASecurePassword2026!
ADMIN_INITIAL_EMAIL=admin@igot.gov.in

# Cryptographic Salt for Password Hashing (Change to a unique random string in production)
ADMIN_PASSWORD_SALT=sih_igot_salt_change_me_in_production

# Backend Server Port
PORT=3001
